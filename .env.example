# Porta su cui gira il server (Hostinger la imposta di solito da sola tramite process.env.PORT)
PORT=3000

# Fuso orario usato per data/ora mostrate sul display
TZ=Europe/Rome

# Credenziali dell'app Netatmo (create su https://dev.netatmo.com/apps)
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Primo refresh token ottenuto con "npm run get-netatmo-token" (vedi README).
# Dopo il primo avvio il server lo aggiorna da solo in data/netatmo-token.json,
# quindi questo valore serve solo per il primissimo bootstrap.
NETATMO_REFRESH_TOKEN=

# Ogni quanto il TRMNL deve ricontattare il server per aggiornare il display (in secondi).
# 1800 = 30 minuti. Non serve scendere sotto i 900 (15 min): Netatmo e Open-Meteo
# non aggiornano i dati più spesso di così.
REFRESH_RATE_SECONDS=1800

# Coordinate usate per le previsioni meteo (default: Torino centro)
WEATHER_LAT=45.0703
WEATHER_LON=7.6869

# URL pubblico del server una volta online su Hostinger (es. https://display.tuodominio.it).
# Se lo lasci vuoto, il server prova a ricostruirlo da solo dalla richiesta HTTP,
# ma se usi un dominio/sottodominio dedicato è più affidabile impostarlo qui.
PUBLIC_BASE_URL=
